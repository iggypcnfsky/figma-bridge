# QuiverAI — vector generation (Generate → Vector in the panel, `figma svg …` in the terminal).
# Create the key at https://platform.quiver.ai/api-keys, then copy this file to .env and fill it in.
# The API bills per token from a prepaid balance; the panel shows the charge after each run.
QUIVERAI_API_KEY=

# Optional: point the bridge at a different host (tests, a proxy). Defaults to https://api.quiver.ai/v1
# QUIVER_BASE_URL=https://api.quiver.ai/v1

# Two vector jobs run in parallel by default; raise it carefully — each one is billable.
# SVG_CONCURRENCY=2
