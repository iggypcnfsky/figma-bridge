#!/usr/bin/env bash
# figma — CLI do mostka Figma Bridge.
#   figma status                    stan mostka i pluginu
#   figma agents                    kto pracuje na tym canvasie (agenci + ich stan)
#   figma selection [depth]         co jest zaznaczone w Figmie
#   figma pages                     lista stron
#   figma op '<json>'               jedna operacja
#   figma run '<json-array>'        kilka operacji po kolei
#   figma run - <<< '[{"op":"ping"}]'
#   figma export <nodeId> <plik> [format] [scale]
set -euo pipefail

# Ścieżka repo liczona z realnego pliku (działa też przez symlink w ~/.local/bin).
SELF=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")
REPO=$(dirname "$(dirname "$SELF")")

BASE="${FIGMA_BRIDGE_URL:-http://127.0.0.1:3847}"

# Kilka okien Figmy może mieć plugin otwarty; --file/--client wybiera cel.
TARGET_FILE="${FIGMA_BRIDGE_FILE:-}"
TARGET_CLIENT="${FIGMA_BRIDGE_CLIENT:-}"
# Tożsamość agenta: panel widzi ją jako „kto jest na canvasie”. Bez tego każdy proces byłby „cli”.
AGENT="${FIGMA_AGENT:-${DSH_SESSION_ID:+dsh:$DSH_SESSION_ID}}"
AGENT="${AGENT:-cli}"
# Czytelna nazwa obok id — np. tytuł czatu albo „Rafał / Codex”.
AGENT_LABEL="${FIGMA_AGENT_LABEL:-}"
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --file) TARGET_FILE="${2:-}"; shift 2 ;;
    --client) TARGET_CLIENT="${2:-}"; shift 2 ;;
    --agent) AGENT="${2:-cli}"; shift 2 ;;
    --label) AGENT_LABEL="${2:-}"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

CMD="${1:-status}"
shift || true

die() { echo "figma: $*" >&2; exit 1; }

post_run() {
  local payload="$1" extra="${2:-}" target=""
  if [ -n "$TARGET_FILE" ]; then
    target=",\"file\":\"${TARGET_FILE//\"/}\""
  fi
  if [ -n "$TARGET_CLIENT" ]; then
    target="$target,\"client\":\"${TARGET_CLIENT//\"/}\""
  fi
  local label_header=()
  if [ -n "$AGENT_LABEL" ]; then
    # nagłówki HTTP są latin-1 — polskie znaki i emoji muszą przejść przez encodeURIComponent
    label_header=(-H "x-agent-label: $(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$AGENT_LABEL")")
  fi
  curl -sS -X POST "$BASE/run" \
    -H 'content-type: application/json' \
    -H "x-agent: $AGENT" \
    ${label_header[@]+"${label_header[@]}"} \
    --data "{\"ops\":$payload$target${extra}}" || die "cannot reach $BASE (is the server running?)"
}

pretty() {
  python3 -c 'import json,sys
raw = sys.stdin.read()
try:
    print(json.dumps(json.loads(raw), indent=2, ensure_ascii=False))
except Exception:
    print(raw)'
}

case "$CMD" in
  agents)
    curl -sS "$BASE/status" 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
agents = d.get("agents") or []
if not agents:
    print("no agent has touched this canvas yet")
else:
    for a in agents:
        name = a.get("name") or a.get("id")
        state = ("busy " + a["busy"]) if a.get("busy") else ("idle " + str(round(a.get("idleMs", 0) / 1000)) + "s")
        print("%-22s %-14s runs=%-4s ops=%-5s id=%s" % (name, state, a.get("runs"), a.get("ops"), a.get("id")))
    print()
    print(str(d.get("agentCount", len(agents))) + " agent(s) known, " + str(len(d.get("clients") or [])) + " window(s) connected")
' || die "cannot reach $BASE (is the server running?)"
    ;;

  rules)
    if [ -f "$REPO/rules.json" ]; then
      cat "$REPO/rules.json"
    else
      echo '{}'
      echo "no rules.json in $REPO — copy rules.example.json and fill in this project's constraints" >&2
    fi
    ;;

  where)
    echo "$REPO"
    ;;

  doctor)
    echo "repo:      $REPO"
    echo "server:    $BASE"
    printf 'bridge:    '
    if curl -sf -m 2 "$BASE/status" > /tmp/figma-doctor.json; then
      python3 -c '
import json
data = json.load(open("/tmp/figma-doctor.json"))
clients = data.get("clients") or []
print("up, plugin connected" if clients else "up, but no Figma window connected")
for entry in clients:
    print("             %s  %s / %s" % (entry.get("client"), entry.get("file") or "?", entry.get("page") or "?"))
'
    else
      echo "down — start it with: dsh (the Figma Bridge plugin does it) or: node \"$REPO/server.mjs\""
    fi
    printf 'img-forge: '
    if [ -x "$REPO/../img-forge/img" ]; then
      if grep -q '^FAL_KEY=' "$REPO/../img-forge/.env" 2>/dev/null || [ -n "${FAL_KEY:-}" ] || [ -f "$HOME/.config/img-forge/key" ]; then
        echo "present, FAL key set"
      else
        echo "present, FAL key MISSING"
      fi
    else
      echo "missing (image generation unavailable)"
    fi
    printf 'quiver:    '
    if [ -n "${QUIVERAI_API_KEY:-}" ] || grep -q '^QUIVERAI_API_KEY=' "$REPO/.env" 2>/dev/null; then
      echo "key set (vector generation available)"
    else
      echo "key MISSING — add QUIVERAI_API_KEY=... to $REPO/.env"
    fi
    ;;

  status|health)
    curl -sS "$BASE/status" | pretty
    ;;

  clients)
    curl -sS "$BASE/status" | python3 -c '
import json, sys
data = json.load(sys.stdin)
clients = data.get("clients") or []
if not clients:
    print("no Figma window connected — run the Figma Bridge plugin in the target file")
    sys.exit(0)
for entry in clients:
    print("%-12s %-22s %-24s %ss" % (entry["client"], entry.get("file") or "?", entry.get("page") or "?", entry.get("connectedSeconds", "?")))
if len(clients) > 1:
    print("\nseveral windows are open: pass --file <NAME> or --client <ID>")
'
    ;;

  ping)
    post_run '[{"op":"ping"}]' | pretty
    ;;

  selection)
    DEPTH="${1:-2}"
    post_run "[{\"op\":\"selection\",\"depth\":$DEPTH}]" | pretty
    ;;

  pages)
    post_run '[{"op":"pages"}]' | pretty
    ;;

  variables)
    post_run '[{"op":"variables"}]' | pretty
    ;;

  op)
    [ $# -ge 1 ] || die "podaj JSON operacji, np. figma op '{\"op\":\"status\"}'"
    post_run "[$1]" | pretty
    ;;

  run)
    if [ "${1:-}" = "-" ] || [ $# -eq 0 ]; then
      PAYLOAD="$(cat)"
    else
      PAYLOAD="$1"
    fi
    EXTRA=""
    for arg in "$@"; do
      case "$arg" in
        --dry-run) EXTRA=',"dryRun":true' ;;
      esac
    done
    post_run "$PAYLOAD" "$EXTRA" | pretty
    ;;

  image)
    NODE="${1:-}"; FILE="${2:-}"
    [ -n "$NODE" ] && [ -n "$FILE" ] || die "usage: figma image <nodeId> <file.png> [FILL|FIT|TILE|CROP]"
    [ -f "$FILE" ] || die "no such file: $FILE"
    MODE="${3:-FILL}"
    python3 - "$NODE" "$FILE" "$MODE" > /tmp/figma-image-payload.json <<'PY2'
import base64, json, sys
node, path, mode = sys.argv[1], sys.argv[2], sys.argv[3]
data = base64.b64encode(open(path, 'rb').read()).decode()
print(json.dumps({"ops": [{"op": "imageFill", "nodeId": node, "base64": data, "scaleMode": mode}]}))
PY2
    curl -sS -X POST "$BASE/run" -H 'content-type: application/json' \
      --data-binary @/tmp/figma-image-payload.json | pretty
    ;;

  svg)
    # Generowanie i wektoryzacja przez QuiverAI; całe zarządzanie zleceniem (w tym --insert)
    # siedzi w scripts/svg-cli.mjs, żeby nie sklejać JSON-a w bashu.
    SVG_ARGS=(--repo "$REPO" --base "$BASE" --agent "$AGENT")
    [ -n "$AGENT_LABEL" ] && SVG_ARGS+=(--label "$AGENT_LABEL")
    [ -n "$TARGET_FILE" ] && SVG_ARGS+=(--file "$TARGET_FILE")
    [ -n "$TARGET_CLIENT" ] && SVG_ARGS+=(--client "$TARGET_CLIENT")
    exec node "$REPO/scripts/svg-cli.mjs" "${SVG_ARGS[@]}" "$@"
    ;;

  export)
    NODE="${1:-}"; OUT="${2:-}"; FMT="${3:-PNG}"; SCALE="${4:-2}"
    [ -n "$NODE" ] && [ -n "$OUT" ] || die "usage: figma export <nodeId> <file.png> [PNG|JPG|SVG|PDF] [scale]"
    post_run "[{\"op\":\"export\",\"nodeId\":\"$NODE\",\"format\":\"$FMT\",\"scale\":$SCALE}]" > /tmp/figma-export.json
    python3 - "$OUT" <<'PY'
import json, sys, base64
data = json.load(open('/tmp/figma-export.json'))
res = (data.get('results') or [{}])[0]
if not res.get('ok'):
    sys.stderr.write('eksport nieudany: %s\n' % (res.get('error') or data.get('error')))
    raise SystemExit(1)
blob = base64.b64decode(res['value']['base64'])
open(sys.argv[1], 'wb').write(blob)
print('%s: %d B (%s, node %s)' % (sys.argv[1], len(blob), res['value']['format'], res['value']['nodeId']))
PY
    ;;

  *)
    die "unknown command '$CMD' (status|clients|where|doctor|rules|ping|selection|pages|variables|op|run|export|image|svg)"
    ;;
esac
